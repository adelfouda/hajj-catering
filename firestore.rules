rules_version = '2';
// قواعد مبدئية: مفتوحة لمجموعات التطبيق فقط — مناسبة لفريق صغير موثوق.
// أي شخص يعرف رابط الموقع يستطيع القراءة والتعديل.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{c}/{id} {
      allow read, write: if c in ['companies','projects','requests','users','invoices','settings'];
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
